{
  "appId": "br.com.kmcheck.app",
  "appName": "KM Check",
  "webDir": "www",
  "backgroundColor": "#0a0c0e",
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "minWebViewVersion": 105
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover"
    }
  },
  "server": {
    "errorPath": "webview-antiga.html"
  }
}
