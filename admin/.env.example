# ─── KM Check Admin — Configuração ───

# Porta do servidor admin
ADMIN_PORT=3457

# Credenciais do administrador
ADMIN_USER=admin
# Gere o hash com: npm run hash -- "SuaSenhaAqui"
ADMIN_HASH=

# Chave secreta para tokens JWT (gere string aleatória longa)
# Ex: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

# URL da API principal do KM Check (para buscar versões e rodovias disponíveis)
CONTROLCHECK_API=https://controlcheck.duckdns.org/api
