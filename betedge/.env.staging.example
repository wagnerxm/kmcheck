# === Supabase (Staging) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# === Motor Estatístico (FastAPI) ===
ENGINE_URL=http://engine-staging:8000
ENGINE_API_KEY=staging-engine-key
ENV=staging
DEBUG=false

# === Redis ===
REDIS_URL=redis://redis-staging:6379

# === SportsGameOdds ===
SPORTSGAMEODDS_API_KEY=your-staging-api-key
SPORTSGAMEODDS_BASE_URL=https://api.sportsgameodds.com/v2

# === Shadow Mode ===
SHADOW_DRY_RUN=false
SHADOW_ENABLED=true

# === App ===
NEXT_PUBLIC_APP_URL=https://staging.betedge.app
NODE_ENV=production
